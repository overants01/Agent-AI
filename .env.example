# เลือกเปิดใช้เพียงชุดเดียว และใส่ API key จากค่ายนั้น
# LOCAL_PROMPT, SANDBOX_PATH และ MESSAGE_HISTORY เป็นค่ากลาง ใช้ได้กับทุก provider
# Gemini
API_KEY="YOUR_API_KEY"
LLM="Gemini"
MODEL="gemini-2.5-flash"
LOCAL_PROMPT=""
SANDBOX_PATH="sandbox"
MESSAGE_HISTORY=0000

# OpenAI: API_KEY="YOUR_OPENAI_API_KEY", LLM="OpenAI", MODEL="gpt-4o-mini"
# Groq: API_KEY="YOUR_GROQ_API_KEY", LLM="Groq", MODEL="llama-3.3-70b-versatile"
# OpenRouter: API_KEY="YOUR_OPENROUTER_API_KEY", LLM="OpenRouter", MODEL="openai/gpt-4o-mini"
# Anthropic: API_KEY="YOUR_ANTHROPIC_API_KEY", LLM="Anthropic", MODEL="claude-sonnet-4-5"
# LocalAI: API_KEY="", LLM="LocalAI", MODEL="your-installed-model", LOCALAI_ENDPOINT="http://localhost:8080/v1/chat/completions"